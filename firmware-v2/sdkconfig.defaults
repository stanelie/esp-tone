# esp-tone v2 spike. Deliberately plain: stock heap, stock I2S, no custom allocator.
# MEASURED: at 10 TX packets the device dropped 0.263% of frames at sendto() with errno 12
# (ENOMEM), in bursts of up to 11 per 5 s, and that fully accounted for the packet loss the player
# was concealing - the air was contributing almost nothing. The SDK's own help for this option
# describes the case exactly: "especially UDP applications, the upper layer can deliver frames
# faster than WiFi layer can transmit... we may run out of TX packets." 16 is the maximum; each
# buffer costs ~1.6 KB, so this is ~9.6 KB more RAM out of ~55 KB free.
CONFIG_ESP8266_WIFI_TX_PKT_NUM=16
CONFIG_ESP8266_PHY_MAX_WIFI_TX_POWER=20
CONFIG_ESPTOOLPY_FLASHSIZE_1MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DOUT=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# Explicit: the SDK default is 74880, which silently mismatches every serial tool here.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
