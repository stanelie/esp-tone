<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a cartoon ear.

  Adaptive icons are 108x108dp but only the central 72dp survives every launcher mask, so the
  drawing is authored full-bleed and then scaled to 0.72 about the centre, which keeps the whole
  ear - lobe included - inside the circular mask with margin to spare.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- ear body -->
        <path
            android:pathData="M56,13 C77,13 89,30 88,50 C87,64 78,72 73,81 C69,89 70,97 58,98 C47,99 40,92 41,83 C42,74 46,70 41,61 C33,48 31,34 39,23 C44,16 49,13 56,13 Z"
            android:fillColor="#F0B183"
            android:strokeColor="#5A3214"
            android:strokeWidth="5.5"
            android:strokeLineJoin="round" />
        <!-- antihelix: the single inner ridge; anything more reads as a spiral at launcher size -->
        <path
            android:pathData="M76,46 C68,32 49,35 48,51 C47,63 55,72 65,69"
            android:strokeColor="#5A3214"
            android:strokeWidth="5.5"
            android:strokeLineCap="round" />
    </group>
</vector>
